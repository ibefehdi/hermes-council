BM Plex Sans Arabic\", -apple-system, system-ui, \"Segoe UI\", Roboto,\n    \"Helvetica Neue\", sans-serif;\n  --text-page-title: 700 28px/1.3 var(--font-sans);\n  --text-section-title: 600 22px/1.25 var(--font-sans);\n  --text-card-title: 600 18px/1.3 var(--font-sans);\n  --text-label: 500 16px/1.25 var(--font-sans);\n  --text-label-small: 500 14px/1.25 var(--font-sans);\n  --text-body: 400 16px/1.5 var(--font-sans);\n  --text-dense: 400 14px/1.43 var(--font-sans);\n  --text-caption: 400 13px/1.4 var(--font-sans);\n  --text-badge: 600 12px/1.2 var(--font-sans);\n\n  /* Spacing (4px grid) */\n  --space-2xs: 2px;\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 12px;\n  --space-base: 16px;\n  --space-lg: 24px;\n  --space-xl: 32px;\n  --space-2xl: 48px;\n  --space-section: 64px;\n\n  /* Radii */\n  --radius-sm: 8px;\n  --radius-md: 14px;\n  --radius-xl: 32px;\n  --radius-full: 9999px;\n\n  /* Elevation: one tier */\n  --shadow-float: rgb(0 0 0 / 0.02) 0 0 0 1px, rgb(0 0 0 / 0.04) 0 2px 6px 0, rgb(0 0 0 / 0.1) 0 4px 8px 0;\n\n  /* Sizes */\n  --control-height: 48px;\n  --control-height-dense: 44px;\n  --row-height: 48px;\n  --row-height-compact: 40px;\n  --icon-button: 40px;\n  --form-max-width: 640px;\n  --panel-max-width: 440px;\n  --sidebar-width: 240px;\n  --content-max-width: 1440px;\n\n  /* Motion */\n  --duration-fast: 150ms;\n  --duration-base: 200ms;\n  --ease-out: cubic-bezier(0.2, 0, 0, 1);\n\n  /* Breakpoints (for reference; use in media queries as literals) */\n  /* mobile < 744px, tablet 744-1127px, desktop 1128-1439px, wide >= 1440px */\n}\n\n/* Dark palette (product extension; Airbnb has no dark mode). Screen only, so print stays light.\n   The two blocks below must stay identical. */\n@media screen {\n  :root[data-theme=\"dark\"] {\n    color-scheme: dark;\n    --color-primary: #ff385c;\n    --color-primary-strong: #e00b41;\n    --color-primary-text: #ff5a75;\n    --color-primary-disabled: #5a1f2c;\n    --color-on-primary: #ffffff;\n    --color-c