\n  grid-template-columns: 1fr;\n}\n\n.sx__year-grid-month {\n  min-width: 0;\n  padding: var(--sx-spacing-padding4);\n  background-color: var(--sx-color-background);\n}\n\n.sx__year-grid-month__heading {\n  margin: 0 0 var(--sx-spacing-padding4);\n  font-size: var(--sx-font-small);\n  font-weight: 700;\n}\n\n.sx__year-grid-month__weekdays,\n.sx__year-grid-month__days {\n  display: grid;\n  grid-template-columns: repeat(7, minmax(1.5rem, 1fr));\n  text-align: center;\n}\n\n.sx__year-grid-month__weekdays {\n  margin-bottom: var(--sx-spacing-padding1);\n  color: var(--sx-color-neutral);\n  font-size: 0.625rem;\n  font-weight: 700;\n}\n\n.sx__year-grid-month__days {\n  row-gap: var(--sx-spacing-padding1);\n}\n\n.sx__year-grid-day {\n  position: relative;\n  display: flex;\n  aspect-ratio: 1.25;\n  min-width: 1.5rem;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--sx-rounding-small);\n  color: var(--sx-internal-color-text);\n  font-size: var(--sx-font-extra-small);\n}\n.sx__year-grid-day:hover, .sx__year-grid-day:focus-visible {\n  background-color: var(--sx-color-surface-container-high);\n}\n.sx__year-grid-day.is-selected {\n  box-shadow: 0 0 0 2px var(--sx-color-primary);\n}\n.sx__year-grid-day.sx__is-today {\n  color: var(--sx-color-on-primary);\n  background-color: var(--sx-color-primary);\n  font-weight: 700;\n}\n.sx__year-grid-day:disabled {\n  opacity: 0.38;\n}\n\n.sx__year-grid-day__event-icons {\n  position: absolute;\n  bottom: 2px;\n  display: flex;\n  gap: 2px;\n}\n\n.sx__year-grid-day__event-icon {\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  filter: brightness(1.35);\n}\n.is-dark .sx__year-grid-day__event-icon {\n  filter: none;\n}\n.sx__year-grid-day.sx__is-today .sx__year-grid-day__event-icon {\n  background-color: currentcolor !important;\n}\n\n.sx__year-grid-day-events-modal {\n  position: absolute;\n  z-index: 2;\n  width: min(20rem, 100% - 16px);\n  max-height: 250px;\n  padding: var(--sx-spacing-padding6);\n  border-radius: var(--sx-rounding-small);\n  background-color: var(--sx-color-background);\n  box-shadow: 0 24px 38px 3px rgba(0, 0, 0, 0.14), 0 9px 46px 8px rgba(0, 0, 0, 0.12), 0 11px 15px -7px rgba(0, 0, 0, 0.2);\n  transition: opacity 0.1s ease-out;\n}\n.is-dark .sx__year-grid-day-events-modal {\n  background-color: var(--sx-color-surface-container-high);\n}\n\n.sx__year-grid-day-events-modal__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: var(--sx-spacing-padding2);\n}\n\n.sx__year-grid-day-events-modal__date {\n  font-size: var(--sx-font-large);\n  line-height: 2rem;\n}\n\n.sx__year-grid-day-events-modal__close {\n  width: 2rem;\n  height: 2rem;\n  border-radius: var(--sx-rounding-extra-small);\n  color: var(--sx-color-neutral);\n  font-size: var(--sx-font-large);\n  line-height: 1;\n}\n.sx__year-grid-day-events-modal__close:hover, .sx__year-grid-day-events-modal__close:focus-visible {\n  background-color: var(--sx-color-surface-container-high);\n}\n\n.sx__year-grid-day-events-modal__events {\n  max-height: 10rem;\n  overflow-y: auto;\n}\n.sx__year-grid-day-events-modal__events .sx__month-agenda-event {\n  cursor: pointer;\n}\n\n.sx__week-grid__time-axis {\n  display: flex;\n  flex-flow: column;\n  position: absolute;\n  right: 0;\n  top: var(--sx-week-grid-offset-top);\n  width: calc(100% - 60px);\n}\n\n.sx__week-grid__hour {\n  position: relative;\n  height: var(--sx-week-grid-hour-height);\n  border-top: var(--sx-border);\n  font-size: var(--sx-font-extra-small);\n}\n.sx__week-grid__hour:first-child {\n  visibility: hidden;\n}\n\n.sx__week-grid__hour-text {\n  position: absolute;\n  left: -43px;\n  top: -0.75em;\n  color: var(--sx-color-neutral);\n}\n\n.sx__time-grid-day {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  border-left: var(--sx-border);\n}\n\n.sx__week-grid__date-axis {\n  padding-left: var(--sx-calendar-week-grid-padding-left);\n  display: flex;\n}\n\n.sx__week-grid__date {\n  flex: 1;\n  display: flex;\n  flex-flow: column;\n  align-items: center;\n  padding: var(--sx-spacing-padding3) 0;\n  gap: var(--sx-spacing-padding1);\n}\n\n.sx__week-grid__day-name {\n  text-transform: uppercase;\n  font-size: var(--sx-font-extra-small);\n  color: var(--sx-color-neutral);\n  font-weight: 500;\n}\n.sx__week-grid__date--is-today .sx__week-grid__day-name {\n  color: var(--sx-color-primary);\n  font-weight: 700;\n}\n\n.sx__week-grid__date-number {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--sx-font-extra-large);\n  font-weight: 500;\n  color: var(--sx-color-neutral);\n  height: 2em;\n  width: 2em;\n}\n.sx__week-grid__date--is-today .sx__week-grid__date-number {\n  background-color: var(--sx-color-primary);\n  color: var(--sx-color-on-primary);\n  border-radius: 50%;\n}\n\n.sx__time-grid-event {\n  width: calc(100% - 10px);\n  padding: var(--sx-spacing-padding1);\n  position: absolute;\n  border-radius: var(--sx-rounding-extra-small);\n  font-size: var(--sx-font-extra-small);\n  overflow: hidden;\n  -webkit-user-select: none;\n  user-select: none;\n}\n.sx__time-grid-event.is-event-copy {\n  opacity: 0.5;\n  box-shadow: var(--sx-box-shadow-level3);\n  z-index: 1;\n  transition: transform 0.15s ease-in-out;\n}\n.sx__time-grid-event.is-event-new {\n  animation: sx-grow-event 0.3s ease-in-out forwards;\n}\n@keyframes sx-grow-event {\n  0% {\n    transform: scale(0);\n    opacity: 0;\n  }\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n\n[data-has-dnd=true] .sx__time-grid-event {\n  touch-action: none;\n}\n\n.sx__is-resizing .sx__time-grid-event:has(+ .is-event-copy) {\n  opacity: 0;\n}\n.sx__is-resizing .is-event-copy {\n  opacity: 1;\n}\n\n.sx__time-grid-event-inner {\n  position: relative;\n  height: 100%;\n}\n\n.sx__time-grid-event-resize-handle {\n  display: block;\n  position: absolute;\n  width: 100%;\n  bottom: 0;\n  cursor: ns-resize;\n  height: clamp(10px, 20px, 50%);\n  touch-action: none;\n}\n\n.sx__time-grid-event-title {\n  font-weight: 600;\n}\n\n.sx__time-grid-event-time,\n.sx__time-grid-event-people,\n.sx__time-grid-event-location {\n  display: flex;\n  align-items: center;\n  white-space: nowrap;\n}\n\n.sx__title-and-time-compact {\n  display: flex;\n  align-items: center;\n  gap: var(--sx-spacing-padding2);\n}\n.sx__title-and-time-compact .sx__time-grid-event-title {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.sx__title-and-time-compact .sx__time-grid-event-time {\n  flex-shrink: 0;\n}\n\n.sx__event-icon {\n  min-width: 15px;\n  min-height: 15px;\n  max-width: 15px;\n  max-height: 15px;\n  margin-inline-end: var(--sx-spacing-padding2);\n}\n\n.sx__date-grid {\n  display: flex;\n  padding-left: var(--sx-calendar-week-grid-padding-left);\n}\n\n.sx__date-grid-day {\n  position: relative;\n  width: 100%;\n  display: grid;\n  grid-gap: 2px;\n  /* needed for the draw plugin */\n}\n.sx__date-grid-day .sx__spacer {\n  display: var(--sx-draw-plugin-spacer-display, none);\n  height: var(--sx-draw-plugin-spacer);\n}\n\n.sx__date-grid-event {\n  z-index: 1;\n  position: relative;\n  display: flex;\n  align-items: center;\n  padding: var(--sx-spacing-padding1);\n  border-radius: var(--sx-rounding-extra-small);\n  font-size: clamp(12px, var(--sx-font-extra-small), 14px);\n  font-weight: 600;\n  user-select: none;\n}\n.sx__date-grid-event:has(.sx__date-grid-event--left-overflow) {\n  margin-left: 10px;\n}\n.sx__date-grid-event:has(.sx__date-grid-event--right-overflow) {\n  margin-right: 10px;\n}\n.sx__date-grid-event.is-event-new {\n  animation: sx-grow-event 0.3s ease-in-out forwards;\n}\n@keyframes sx-grow-event {\n  0% {\n    transform: scale(0);\n    opacity: 0;\n  }\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n.sx__date-grid-event .sx__date-grid-event--left-overflow {\n  position: absolute;\n  z-index: 1;\n  width: 10px;\n  height: 100%;\n  left: -10px;\n  clip-path: polygon(100% 0, 0 50%, 100% 100%, 100% 0);\n}\n.sx__date-grid-event .sx__date-grid-event--right-overflow {\n  position: absolute;\n  z-index: 1;\n  width: 10px;\n  height: 100%;\n  right: -10px;\n  clip-path: polygon(0 0, 100% 50%, 0 100%, 0 0);\n}\n.sx__date-grid-event.sx__date-grid-event--copy {\n  z-index: 2;\n  box-shadow: var(--sx-box-shadow-level3);\n  transition-property: transform, width;\n  transition-duration: 0.15s;\n  transition-timing-function: ease-in-out;\n}\n\n.sx__date-grid-event-text {\n  width: calc(100% - var(--sx-spacing-padding1) * 2);\n  left: var(--sx-spacing-padding1);\n  position: absolute;\n  text-overflow: ellipsis;\n  overflow-x: hidden;\n  white-space: nowrap;\n}\n.sx__date-grid-event-text .sx__date-grid-event-time {\n  font-weight: initial;\n}\n\n.sx__date-grid-cell {\n  height: clamp(20px, 1.25rem, 24px);\n}\n\n.sx__date-grid-event-resize-handle {\n  position: absolute;\n  right: 0;\n  height: 100%;\n  width: clamp(10px, 15px, 50%);\n  cursor: ew-resize;\n  z-index: 1;\n  touch-action: none;\n}\n[dir=rtl] .sx__date-grid-event-resize-handle {\n  left: 0;\n  right: auto;\n}\n\n.sx__date-grid-background-event {\n  position: absolute;\n  height: 100%;\n  width: 100%;\n  top: 0;\n  left: 0;\n  z-index: -1;\n}\n\n:root {\n  --sx-week-grid-height: 0;\n  --sx-time-axis-height: 0;\n  --sx-week-grid-hour-height: 0;\n  --sx-week-grid-offset-top: 0;\n}\n\n.sx__event-modal {\n  visibility: hidden;\n  position: fixed;\n  top: var(--sx-event-modal-top);\n  left: var(--sx-event-modal-left);\n  width: 400px;\n  max-width: 100%;\n  height: fit-content;\n  background-color: var(--sx-color-background);\n  z-index: var(--sx-z-index-event-modal);\n}\n.sx__event-modal.is-open {\n  animation: slide-sideways;\n  animation-duration: 0.3s;\n  visibility: initial;\n}\n.is-dark .sx__event-modal {\n  background-color: var(--sx-color-surface-container-high);\n}\n\n.sx__event-modal-default {\n  padding: var(--sx-spacing-padding6);\n  background-color: var(--sx-color-background);\n  box-shadow: 0 24px 38px 3px rgba(0, 0, 0, 0.14), 0 9px 46px 8px rgba(0, 0, 0, 0.12), 0 11px 15px -7px rgba(0, 0, 0, 0.2);\n  border-radius: var(--sx-rounding-small);\n  max-height: 250px;\n  overflow-y: scroll;\n}\n\n@keyframes slide-sideways {\n  from {\n    opacity: 0;\n    transform: translateX(var(--sx-event-modal-animation-start));\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n.sx__event-modal .sx__event-icon {\n  min-width: 16px;\n  min-height: 16px;\n  max-width: 16px;\n  max-height: 16px;\n  margin-inline-end: var(--sx-spacing-padding2);\n}\n\n.sx__event-modal__color-icon {\n  display: inline-block;\n  width: 16px;\n  height: 16px;\n  border-radius: 25%;\n  margin-inline-end: var(--sx-spacing-padding3);\n}\n\n.sx__has-icon {\n  display: grid;\n  align-items: flex-start;\n  grid-template-columns: 30px 1fr;\n  margin-bottom: var(--sx-spacing-padding2);\n}\n.sx__has-icon .sx__event-icon {\n  margin-top: 2px;\n}\n.sx__has-icon .sx__event-modal__color-icon {\n  margin-top: 4px;\n}\n\n.sx__event-modal__title {\n  font-size: var(--sx-font-large);\n}\n\n.sx__event-modal__time {\n  font-size: var(--sx-font-small);\n}\n\n.sx__current-time-indicator {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background-color: #f00;\n  z-index: 0;\n}\n.sx__current-time-indicator::before {\n  content: \"\";\n  position: absolute;\n  left: -5px;\n  top: -4px;\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background-color: #f00;\n}\n\n.sx__current-time-indicator-full-week {\n  width: calc(100% - var(--sx-calendar-week-grid-padding-left));\n  position: absolute;\n  inset: 0 0 0 var(--sx-calendar-week-grid-padding-left);\n  height: 2px;\n  background-color: rgba(255, 0, 0, 0.38);\n}\n"],["STYLE",{},"/* schedule-x renders plain class names, so this sheet is global but scoped under .gd-booking-calendar. */\n\n.gd-booking-calendar {\n  --gd-column-min: 148px;\n  --gd-axis-width: 64px;\n  /* Closed: the branch's hours minus closed periods. Off: open, but no shift. Blocked: breaks and time off. */\n  --gd-shade-closed: repeating-linear-gradient(135deg, var(--color-surface-strong) 0 2px, var(--color-surface-soft) 2px 10px);\n  --gd-shade-off: linear-gradient(var(--color-surface-soft), var(--color-surface-soft));\n  --gd-shade-blocked: repeating-linear-gradient(45deg, var(--color-hairline) 0 2px, var(--color-surface-soft) 2px 8px);\n\n  block-size: 100%;\n  min-block-size: 480px;\n}\n\n/* Map the library palette onto our tokens; the tokens already switch with the theme. */\n.gd-booking-calendar .sx__calendar-wrapper {\n  --sx-color-primary: var(--color-primary);\n  --sx-color-on-primary: var(--color-on-primary);\n  --sx-color-primary-container: var(--color-surface-strong);\n  --sx-color-on-primary-container: var(--color-ink);\n  --sx-color-surface: var(--color-canvas);\n  --sx-color-surface-bright: var(--color-surface-raised);\n  --sx-color-surface-dim: var(--color-surface-soft);\n  --sx-color-on-surface: var(--color-ink);\n  --sx-color-surface-container: var(--color-surface-soft);\n  --sx-color-surface-container-low: var(--color-surface-soft);\n  --sx-color-surface-container-high: var(--color-surface-strong);\n  --sx-color-background: var(--color-canvas);\n  --sx-color-on-background: var(--color-ink);\n  --sx-color-outline: var(--color-muted-soft);\n  --sx-color-outline-variant: var(--color-hairline-soft);\n  --sx-color-neutral: var(--color-muted);\n  --sx-internal-color-text: var(--color-ink);\n  --sx-calendar-week-grid-padding-left: var(--gd-axis-width);\n\n  font: var(--text-dense);\n}\n\n/* Our toolbar replaces the library header (Latin digits in Arabic; ADR-41 gap 1). */\n.gd-booking-calendar .sx__calendar-header {\n  display: none;\n}\n\n.gd-booking-calendar .sx__view-container {\n  overflow: auto;\n}\n\n.gd-resource-day {\n  min-inline-size: calc(var(--gd-axis-width) + var(--gd-columns) * var(--gd-column-min));\n}\n\n.gd-resource-header {\n  display: flex;\n  position: sticky;\n  inset-block-start: 0;\n  z-index: 3;\n  background-color: var(--color-canvas);\n  border-block-end: 1px solid var(--color-hairline);\n}\n\n.gd-resource-axis-spacer {\n  flex: 0 0 var(--gd-axis-width);\n  position: sticky;\n  inset-inline-start: 0;\n  z-index: 1;\n  background-color: var(--color-canvas);\n}\n\n.gd-resource-heading {\n  flex: 1 1 0;\n  min-inline-size: var(--gd-column-min);\n  border-inline-start: 1px solid var(--color-hairline-soft);\n}\n\n.gd-resource-new {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-xs);\n  inline-size: 100%;\n  min-block-size: var(--row-height-compact);\n  padding-block: var(--space-xs);\n  padding-inline: var(--space-sm);\n  border: 0;\n  background: transparent;\n  color: var(--color-ink);\n  font: var(--text-label-small);\n  text-align: start;\n  cursor: pointer;\n}\n\n.gd-resource-label {\n  display: flex;\n  align-items: center;\n  min-block-size: var(--row-height-compact);\n  padding-block: var(--space-xs);\n  padding-inline: var(--space-sm);\n  color: var(--color-ink);\n  font: var(--text-label-small);\n}\n\n.gd-resource-new:hover {\n  background-color: var(--color-surface-soft);\n}\n\n.gd-resource-new:focus-visible {\n  outline: 2px solid var(--color-ink);\n  outline-offset: -2px;\n}\n\n.gd-resource-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.gd-resource-plus {\n  color: var(--color-muted);\n  font: var(--text-label);\n}\n\n/* clip, not the theme's hidden: a scroll container here would pin the sticky axis to the grid. */\n.gd-booking-calendar .gd-resource-grid {\n  padding: 0;\n  overflow: clip;\n}\n\n/* Hour labels in their own column that stays put while the staff columns scroll sideways (gap 8). */\n.gd-resource-axis {\n  flex: 0 0 var(--gd-axis-width);\n  position: sticky;\n  inset-inline-start: 0;\n  z-index: 2;\n  background-color: var(--color-canvas);\n}\n\n.gd-resource-hour {\n  position: absolute;\n  inset-inline-start: var(--space-sm);\n  margin-block-start: -0.75em;\n  color: var(--color-muted);\n  font: var(--text-caption);\n  white-space: nowrap;\n}\n\n.gd-resource-hour:first-child {\n  margin-block-start: 0;\n}\n\n.gd-resource-column {\n  position: relative;\n  flex: 1 1 0;\n  min-inline-size: var(--gd-column-min);\n  block-size: 100%;\n}\n\n/* The current time, on the branch's today only: a line across each column and a dot on the hour axis. */\n.gd-now-line {\n  position: absolute;\n  inset-inline: 0;\n  z-index: 2;\n  block-size: 0;\n  border-block-start: 2px solid var(--color-primary);\n  pointer-events: none;\n}\n\n.gd-now-dot {\n  position: absolute;\n  inset-inline-end: -5px;\n  z-index: 1;\n  inline-size: 10px;\n  block-size: 10px;\n  margin-block-start: -4px;\n  border-radius: 50%;\n  background-color: var(--color-primary);\n}\n\n/* The theme positions the time axis physically; mirror it for RTL. */\n.gd-booking-calendar .sx__week-grid__time-axis {\n  inset: auto;\n  inset-block-start: var(--sx-week-grid-offset-top);\n  inset-inline-end: 0;\n  inline-size: calc(100% - var(--gd-axis-width));\n}\n\n.gd-booking-calendar .sx__week-grid__hour-text {\n  display: none;\n}\n\n/* Shaded time; each range picks its pattern inline. Booking there still works with an override. */\n.gd-booking-calendar .sx__time-grid-background-event {\n  pointer-events: none;\n}\n\n.gd-booking-calendar .sx__time-grid-day {\n  border: 0;\n  border-inline-start: var(--sx-border);\n}\n\n.gd-booking-calendar .sx__time-grid-event {\n  border-radius: var(--radius-sm);\n}\n\n.gd-booking-calendar .gd-status-completed,\n.gd-booking-calendar .gd-status-no_show {\n  opacity: 0.7;\n}\n\n.gd-booking-calendar .sx__time-grid-event:focus-visible {\n  outline: 2px solid var(--color-ink);\n  outline-offset: 1px;\n}\n\n/* Skip link into the grid past the column headers (ADR-41 gap 2); shown only while focused. */\n.gd-skip-link {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n.gd-skip-link:focus-visible {\n  inset-block-start: var(--space-xs);\n  inset-inline-start: var(--space-xs);\n  z-index: 5;\n  inline-size: auto;\n  block-size: auto;\n  padding: var(--space-xs) var(--space-sm);\n  clip-path: none;\n  border: 1px solid var(--color-hairline);\n  border-radius: var(--radius-sm);\n  background-color: var(--color-canvas);\n  color: var(--color-ink);\n  font: var(--text-label);\n  outline: 2px solid var(--color-ink);\n  outline-offset: 1px;\n}\n\n.gd-booking-calendar:focus-visible {\n  outline: 2px solid var(--color-ink);\n  outline-offset: -2px;\n}\n\n.gd-event-title,\n.gd-event-time,\n.gd-event-sub {\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.gd-event-title {\n  font: var(--text-badge);\n}\n\n.gd-event-time,\n.gd-event-sub {\n  font: var(--text-caption);\n  color: var(--color-muted);\n}\n"],["STYLE",{},"._page_14nk1_1 {\n  block-size: 100%;\n}\n\n._toolbar_14nk1_5 {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: end;\n  justify-content: space-between;\n  gap: var(--space-md);\n}\n\n._dayNav_14nk1_13 {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n._dayLabel_14nk1_20 {\n  margin: 0;\n  font: var(--text-card-title);\n}\n\n._filters_14nk1_25 {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: end;\n  gap: var(--space-sm);\n}\n\n._jump_14nk1_32 {\n  inline-size: 12rem;\n}\n\n._filter_14nk1_25 {\n  min-inline-size: 11rem;\n}\n\n._staffList_14nk1_40 {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n  max-block-size: 20rem;\n  overflow-y: auto;\n}\n\n._calendar_14nk1_48 {\n  position: relative;\n  block-size: calc(100dvh - 15rem);\n  min-block-size: 480px;\n  overflow: hidden;\n  border: 1px solid var(--color-hairline-soft);\n  border-radius: var(--radius-md);\n}\n\n._calendar_14nk1_48[aria-busy=\"true\"] {\n  opacity: 0.7;\n}\n\n._visuallyHidden_1