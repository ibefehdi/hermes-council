th {\n  min-width: 0;\n  padding: var(--sx-spacing-padding4);\n  background-color: var(--sx-color-background);\n}\n\n.sx__year-grid-month__heading {\n  margin: 0 0 var(--sx-spacing-padding4);\n  font-size: var(--sx-font-small);\n  font-weight: 700;\n}\n\n.sx__year-grid-month__weekdays,\n.sx__year-grid-month__days {\n  display: grid;\n  grid-template-columns: repeat(7, minmax(1.5rem, 1fr));\n  text-align: center;\n}\n\n.sx__year-grid-month__weekdays {\n  margin-bottom: var(--sx-spacing-padding1);\n  color: var(--sx-color-neutral);\n  font-size: 0.625rem;\n  font-weight: 700;\n}\n\n.sx__year-grid-month__days {\n  row-gap: var(--sx-spacing-padding1);\n}\n\n.sx__year-grid-day {\n  position: relative;\n  display: flex;\n  aspect-ratio: 1.25;\n  min-width: 1.5rem;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--sx-rounding-small);\n  color: var(--sx-internal-color-text);\n  font-size: var(--sx-font-extra-small);\n}\n.sx__year-grid-day:hover, .sx__year-grid-day:focus-visible {\n  background-color: var(--sx-color-surface-container-high);\n}\n.sx__year-grid-day.is-selected {\n  box-shadow: 0 0 0 2px var(--sx-color-primary);\n}\n.sx__year-grid-day.sx__is-today {\n  color: var(--sx-color-on-primary);\n  background-color: var(--sx-color-primary);\n  font-weight: 700;\n}\n.sx__year-grid-day:disabled {\n  opacity: 0.38;\n}\n\n.sx__year-grid-day__event-icons {\n  position: absolute;\n  bottom: 2px;\n  display: flex;\n  gap: 2px;\n}\n\n.sx__year-grid-day__event-icon {\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  filter: brightness(1.35);\n}\n.is-dark .sx__year-grid-day__event-icon {\n  filter: none;\n}\n.sx__year-grid-day.sx__is-today .sx__year-grid-day__event-icon {\n  background-color: currentcolor !important;\n}\n\n.sx__year-grid-day-events-modal {\n  position: absolute;\n  z-index: 2;\n  width: min(20rem, 100% - 16px);\n  max-height: 250px;\n  padding: var(--sx-spacing-padding6);\n  border-radius: var(--sx-rounding-small);\n  background-color: var(--sx-color-background);\n  box-shadow: 0 24px 38px 3px rgba(0, 0, 0, 0.14), 0 9px 46px 8px rgba(0, 0, 0, 0.12), 0 11px 15px -7px rgba(0, 0, 0, 0.2);\n  transition: opacity 0.1s ease-out;\n}\n.is-dark .sx__year-grid-day-events-modal {\n  background-color: var(--sx-color-surface-container-high);\n}\n\n.sx__year-grid-day-events-modal__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: var(--sx-spacing-padding2);\n}\n\n.sx__year-grid-day-events-modal__date {\n  font-size: var(--sx-font-large);\n  line-height: 2rem;\n}\n\n.sx__year-grid-day-events-modal__close {\n  width: 2rem;\n  height: 2rem;\n  border-radius: var(--sx-rounding-extra-small);\n  color: var(--sx-color-neutral);\n  font-size: var(--sx-font-large);\n  line-height: 1;\n}\n.sx__year-grid-day-events-modal__close:hover, .sx__year-grid-day-events-modal__close:focus-visible {\n  background-color: var(--sx-color-surface-container-high);\n}\n\n.sx__year-grid-day-events-modal__events {\n  max-height: 10rem;\n  overflow-y: auto;\n}\n.sx__year-grid-day-events-modal__events .sx__month-agenda-event {\n  cursor: pointer;\n}\n\n.sx__week-grid__time-axis {\n  display: flex;\n  flex-flow: column;\n  position: absolute;\n  right: 0;\n  top: var(--sx-week-grid-offset-top);\n  width: calc(100% - 60px);\n}\n\n.sx__week-grid__hour {\n  position: relative;\n  height: var(--sx-week-grid-hour-height);\n  border-top: var(--sx-border);\n  font-size: var(--sx-font-extra-small);\n}\n.sx__week-grid__hour:first-child {\n  visibility: hidden;\n}\n\n.sx__week-grid__hour-text {\n  position: absolute;\n  left: -43px;\n  top: -0.75em;\n  color: var(--sx-color-neutral);\n}\n\n.sx__time-grid-day {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  border-left: var(--sx-border);\n}\n\n.sx__week-grid__date-axis {\n  padding-left: var(--sx-calendar-week-grid-padding-left);\n  display: flex;\n}\n\n.sx__week-grid__date {\n  flex: 1;\n  display: flex;\n  flex-flow: column;\n 