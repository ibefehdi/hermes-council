# Copy to .env and fill in (setup.sh does this for you). Never commit .env.
DASHBOARD_URL=https://staging.example.com
# Only if the login page differs from DASHBOARD_URL:
# DASHBOARD_LOGIN_URL=https://staging.example.com/login

# Optional: pre-filled into the login form.
DASHBOARD_USER=
# Leave empty for OTP / SSO / 2FA logins: a browser opens and you log in yourself once;
# the saved session is reused by every agent until it expires.
DASHBOARD_PASS=
